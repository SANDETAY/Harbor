{
  "name": "harbor-webapp",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Harbor — calm life management. PWA + Capacitor iOS (Desktop home). Android archived under _archive/android.",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File scripts/start-server.ps1",
    "preview": "powershell -ExecutionPolicy Bypass -File scripts/start-server.ps1",
    "zip": "powershell -ExecutionPolicy Bypass -File scripts/create-deploy-zip.ps1",
    "cap:prepare": "bash scripts/cap-prepare.sh",
    "cap:sync": "npm run cap:prepare && npx cap sync ios",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:ios:sync": "npm run cap:prepare && npx cap sync ios",
    "store:prepare": "npm run cap:prepare && npx cap sync ios"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.2.0",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/local-notifications": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@ebarooni/capacitor-calendar": "^6.7.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "supabase": "^2.111.0"
  }
}
