{
  "appId": "com.sandetay.harbor",
  "appName": "Harbor",
  "webDir": "native-www",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "ios": {
    "contentInset": "never",
    "preferredContentMode": "mobile",
    "scheme": "Harbor",
    "allowsLinkPreview": false,
    "scrollEnabled": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 800,
      "launchFadeOutDuration": 280,
      "backgroundColor": "#D6E8E2",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true,
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#D6E8E2",
      "overlaysWebView": true
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
